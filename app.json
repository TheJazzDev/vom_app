{
  "expo": {
    "name": "VOM",
    "slug": "vom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/adaptive-icon-2.png",
    "scheme": "vomapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jazzdev.vom",
      "associatedDomains": [
        "applinks:vom.church",
        "applinks:www.vom.church"
      ],
      "splash": {
        "image": "./src/assets/images/VOM_Light_512x512.png",
        "resizeMode": "contain",
        "backgroundColor": "#E5F2FF",
        "dark": {
          "image": "./src/assets/images/VOM_Dark_512x512.png",
          "backgroundColor": "#0D0D2B"
        }
      }
    },
    "android": {
      "package": "com.jazzdev.vom",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "vom.church",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.vom.church",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon-2.png",
        "monoIconImage": "./src/assets/images/adaptive-icon-2.png",
        "backgroundColor": "#0D0D2B"
      },
      "splash": {
        "image": "./src/assets/images/VOM_Light_512x512.png",
        "resizeMode": "contain",
        "backgroundColor": "#E5F2FF",
        "dark": {
          "image": "./src/assets/images/VOM_Dark_512x512.png",
          "backgroundColor": "#0D0D2B"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/VOM_Light_512x512.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/VOM_Light_1024x1024.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E5F2FF",
          "dark": {
            "backgroundColor": "#0D0D2B",
            "image": "./src/assets/images/VOM_Dark_1024x1024.png"
          }
        }
      ],
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1adecf66-400c-4df2-947b-e1556391e676"
      }
    },
    "owner": "jazzdev"
  }
}
