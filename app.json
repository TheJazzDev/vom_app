{
  "expo": {
    "name": "VOM",
    "slug": "vom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/adaptive-icon-2.jpg",
    "scheme": "vomapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jazzdev.vom",
      "splash": {
        "image": "./src/assets/images/VOM_Light_512x512.png",
        "resizeMode": "contain",
        "backgroundColor": "#E5F2FF",
        "dark": {
          "image": "./src/assets/images/VOM_Dark_512x512.png",
          "backgroundColor": "#0D0D2B"
        }
      }
    },
    "android": {
      "package": "com.jazzdev.vom",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon-2.jpg",
        "backgroundColor": "#0D0D2B"
      },
      "splash": {
        "image": "./src/assets/images/VOM_Light_512x512.png",
        "resizeMode": "contain",
        "backgroundColor": "#E5F2FF",
        "dark": {
          "image": "./src/assets/images/VOM_Dark_512x512.png",
          "backgroundColor": "#0D0D2B"
        }
      }
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/VOM_Light_512x512.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/VOM_Light_1024x1024.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#E5F2FF",
          "dark": {
            "backgroundColor": "#0D0D2B",
            "image": "./src/assets/images/VOM_Dark_1024x1024.png"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1adecf66-400c-4df2-947b-e1556391e676"
      }
    },
    "owner": "jazzdev"
  }
}
