{
  "expo": {
    "name": "VOM",
    "slug": "vom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/VOM_Dark_512x512.png",
    "scheme": "vomapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jazzdev.vom",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#0D0D2B"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.jazzdev.vom",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/VOM_Light_512x512.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0D0D2B"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46ddf191-da43-4759-bad4-d8a1b59e0b16"
      }
    },
    "owner": "jazzdev"
  }
}
